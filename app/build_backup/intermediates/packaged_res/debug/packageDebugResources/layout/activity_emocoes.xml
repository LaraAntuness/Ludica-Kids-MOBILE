<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootTela"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/planoemocoes">

    <!-- Nuvens atrás da girafa -->
    <FrameLayout
        android:id="@+id/camadaNuvens"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Girafa triste em primeiro plano -->
    <ImageView
        android:id="@+id/girafa"
        android:layout_width="170dp"
        android:layout_height="250dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="12dp"
        android:src="@drawable/girafatriste"
        android:scaleType="fitCenter"
        android:contentDescription="Girafa triste" />

    <!-- Botão de retorno -->
    <ImageView
        android:id="@+id/botaoRetorno"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/botaoretornoazul"
        android:scaleType="fitCenter"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Voltar" />

    <!-- Pergunta e mensagens de resposta -->
    <TextView
        android:id="@+id/mensagem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginStart="70dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="9dp"
        android:background="#FFFDF5"
        android:text="O que a girafa está sentindo?"
        android:textColor="#377D4B"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:maxLines="3"
        android:elevation="8dp" />

</FrameLayout>
